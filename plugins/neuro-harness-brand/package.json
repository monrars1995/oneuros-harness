{
  "name": "neuro-harness-brand",
  "version": "0.1.0",
  "description": "Identidade visual do Neuro Harness (logo, nome, marca da tela inicial, título e ícone da aba). Construído sobre o DeepSeek Harness.",
  "license": "MIT",
  "author": "Ramon Ribeiro (monrars1995)",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "LICENSE",
    "NOTICE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    },
    "manifestVersion": 1
  }
}
